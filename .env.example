# Скопируйте в .env (gitignored), заполните локально, chmod 600 .env.
# Для каждой компании используйте отдельный env-файл и каталог выгрузки.
PHONE_ORGANIZATION_ID=
TELPHIN_HOST=apiproxy.telphin.ru
# OAuth application ID / secret, не ID клиента АТС:
TELPHIN_APP_ID=
TELPHIN_APP_SECRET=
# Числовой ID клиента АТС. CLI сверяет его с /user/.
TELPHIN_CLIENT_ID=
