Port 2222
ListenAddress 0.0.0.0
HostKey /var/lib/phone-tunnel/ssh_host_ed25519_key
PidFile /tmp/phone-sshd.pid
AuthorizedKeysFile /var/lib/phone-tunnel/authorized_keys
StrictModes yes
UsePAM no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
PermitRootLogin no
AllowUsers phonebridge
PermitTTY no
X11Forwarding no
AllowAgentForwarding no
AllowStreamLocalForwarding no
AllowTcpForwarding remote
PermitOpen none
PermitListen 0.0.0.0:4096
GatewayPorts clientspecified
PermitUserRC no
ForceCommand python3 /opt/phone-tunnel/server.py health
MaxSessions 2
MaxAuthTries 3
ClientAliveInterval 15
ClientAliveCountMax 3
PrintMotd no
LogLevel ERROR
